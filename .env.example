# Nüsxəsini .env adı ilə yaradın: cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Neon, Railway, Render və ya lokal)
DATABASE_URL=postgres://stockflow:stockflow@127.0.0.1:5432/stockflow_dev

# Ən azı 32 simvol. Yaratmaq üçün: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# iOS refresh token dəstəyi gələnə qədər 7d qoyun, sonra 15m edin.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_VERIFIED_EMAIL=false

# Şəkil saxlama: S3 uyğun (Cloudflare R2, AWS S3, Supabase Storage, MinIO).
# Lokal sınaq üçün STORAGE_DRIVER=memory (şəkillər yaddaşda qalır, istehsalda qadağandır).
STORAGE_DRIVER=memory
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=stockflow-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com

# Email: console (terminalda göstərir) və ya resend
MAIL_DRIVER=console
MAIL_FROM=StockFlow <no-reply@example.com>
# RESEND_API_KEY=

# İstəyə bağlı
# PUBLIC_BASE_URL=https://api.example.com
# CORS_ORIGINS=
# FREE_PRODUCT_LIMIT=50
# DEFAULT_TIMEZONE=Asia/Baku
# DOCS_ENABLED=true
