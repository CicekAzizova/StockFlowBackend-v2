{
  "name": "stockflow-backend",
  "version": "2.0.0",
  "description": "StockFlow REST API",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "migrate:prod": "node dist/db/migrate-cli.js",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
